{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hallpass:ssh-schema:sessions:v1",
  "title": "hallpass.sessions/v1",
  "description": "The agent's grants and access sessions (ssh <gateway> sessions --json).",
  "type": "object",
  "required": [
    "schema",
    "sessions"
  ],
  "properties": {
    "schema": {
      "const": "hallpass.sessions/v1"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "grant_id",
          "session_id",
          "server",
          "role",
          "state",
          "starts_at",
          "expires_at",
          "remaining",
          "ended_at",
          "end_reason",
          "active_connections",
          "total_connections"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "pattern": "^grt_[0-9a-hjkmnp-tv-z]{26}$"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ses_[0-9a-hjkmnp-tv-z]{26}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "server": {
            "$ref": "#/$defs/alias"
          },
          "role": {
            "$ref": "#/$defs/alias"
          },
          "state": {
            "enum": [
              "active",
              "expired",
              "revoked"
            ]
          },
          "starts_at": {
            "$ref": "#/$defs/timestamp"
          },
          "expires_at": {
            "$ref": "#/$defs/timestamp"
          },
          "remaining": {
            "$ref": "#/$defs/duration"
          },
          "ended_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "end_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "active_connections": {
            "type": "integer",
            "minimum": 0
          },
          "total_connections": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "RFC 3339 UTC timestamp, second precision."
    },
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "Go duration string (time.ParseDuration)."
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    }
  }
}
